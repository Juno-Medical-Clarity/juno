# Firebase Service Account
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# For Cloud Run: store the service account JSON in GCP Secret Manager
# as a secret named "firebase-service-account", then set:
# FIREBASE_SERVICE_ACCOUNT_JSON=  # injected by Cloud Run from Secret Manager

# Google Cloud Project
GCP_PROJECT_ID=juno-medical-clarity
GCP_BUCKET_NAME=juno-medical-clarity-backend
GCP_LOCATION=us-central1

# Firestore Database
FIRESTORE_DATABASE_ID=(default)

# Vertex AI Configuration
VERTEX_AI_MODEL=gemini-3.5-flash

# Gemini API (alternative to Vertex AI — simpler setup, just needs an API key)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Simplify Configuration
SIMPLIFY_DEFAULT_VERSION=v1-2

# Dataset GCS bucket (preset research datasets)
DATASETS_BUCKET_NAME=juno-preset-data
