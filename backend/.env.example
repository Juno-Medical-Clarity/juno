# Firebase Service Account
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/serviceAccountKey.json

# For Cloud Run: store the service account JSON in GCP Secret Manager
# as a secret named "firebase-service-account", then set:
# FIREBASE_SERVICE_ACCOUNT_JSON=  # injected by Cloud Run from Secret Manager

# Google Cloud Project
GCP_PROJECT_ID=your-project-id
GCP_BUCKET_NAME=your-bucket-name
GCP_LOCATION=us-central1

# Firestore Database
FIRESTORE_DATABASE_ID=appointments-db

# Vertex AI Configuration
VERTEX_AI_MODEL=gemini-1.5-pro

# Simplify Configuration
SIMPLIFY_DEFAULT_VERSION=v1
